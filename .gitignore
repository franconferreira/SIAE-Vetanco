# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
backend/venv/
ENV/
env/

# Pytest / Testing
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend dependencies and builds
node_modules/
frontend/node_modules/
frontend/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Sensitive configs
.env
backend/.env
*.env.local
*.env.*.local
!backend/.env.example

# Runtime Databases & Temporary Storage
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/siae_staging.db

# Dynamic runtime files (keep directory structure via .gitkeep)
backend/data/lotes_batch/*.csv
!backend/data/lotes_batch/.gitkeep
backend/data/notificaciones/*.txt
backend/data/notificaciones/*.json
!backend/data/notificaciones/.gitkeep
backend/data/pdfs/*
!backend/data/pdfs/.gitkeep
backend/data/casilla_entrante/*
!backend/data/casilla_entrante/.gitkeep

# IDE & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.lnk
