# Configuración General SIAE-Vetanco
APP_NAME="SIAE-Vetanco"
APP_ENV="development"
DEBUG=true

# Base de Datos (SQLite por defecto para ejecución inmediata en Windows)
DATABASE_URL="sqlite:///./data/siae_staging.db"

# Datos Fiscales Vetanco S.A.
VETANCO_CUIT="30623368939"
VETANCO_RAZON_SOCIAL="VETANCO S.A."
SAP_SOCIEDAD="AR01"
CONFIDENCE_THRESHOLD=0.95

# Google Gemini API (Pegar tu clave gratuita de Google AI Studio aquí)
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"

# Ingestor de Mails / Casilla
# Modo: "simulated" (carpeta local + UI) o "imap" (Gmail real)
MAIL_INGESTION_MODE="simulated"
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER="facturas.proveedores.test.franco@gmail.com"
IMAP_PASSWORD=

# Notificaciones de Cierre de Lote (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="facturas.proveedores.test.franco@gmail.com"
SMTP_PASSWORD=
NOTIFICACION_DESTINATARIOS="analista.cuentas@vetanco.com,jefe.proveedores@vetanco.com"

# Horario del Cron Batch SAP (Formato 24hs)
BATCH_CRON_HOUR=17
BATCH_CRON_MINUTE=0
